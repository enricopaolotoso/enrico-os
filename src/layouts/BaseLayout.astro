---
import '../styles/global.css';
import '../styles/desktop.css';
import '../styles/menu-dock.css';
import '../styles/window-manager.css';
import '../styles/apps.css';
import '../styles/finder.css';
import '../styles/spotify.css';
import '../styles/responsive.css';
import { site } from '../data/site';

const {
  title = site.title,
  description = site.description,
  robots = 'index, follow',
  canonical = `${site.url}/`,
  ogUrl = canonical,
  ogType = 'website',
  pageSchemaType = 'ProfilePage',
  structuredDataExtra = []
} = Astro.props;

const socialUrls = Object.values(site.socials).filter(
  (value): value is string => value !== null
);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  givenName: 'Enrico',
  additionalName: 'Paolo',
  familyName: 'Toso',
  alternateName: [site.fullName, site.alternateName, `${site.name} Padova`, `${site.name} Netmarket`],
  jobTitle: site.role,
  disambiguatingDescription: site.disambiguatingDescription,
  description: site.description,
  email: site.email,
  image: `${site.url}/images/foto-profilo-enricotoso.jpg`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Padova',
    addressRegion: 'Veneto',
    addressCountry: 'IT'
  },
  url: site.url,
  mainEntityOfPage: `${site.url}/enrico-toso/`,
  knowsAbout: site.knowsAbout,
  hasOccupation: {
    '@type': 'Occupation',
    name: site.role,
    occupationLocation: {
      '@type': 'City',
      name: 'Padova'
    },
    skills: site.knowsAbout
  },
  homeLocation: {
    '@type': 'Place',
    name: 'Padova, Veneto, Italia'
  },
  affiliation: site.affiliations.map((affiliation) => ({
    '@type': 'Organization',
    name: affiliation.name,
    ...(affiliation.url ? { url: affiliation.url } : {})
  })),
  sameAs: socialUrls
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: `Portfolio di ${site.name}`,
  url: `${site.url}/`,
  description: site.description,
  inLanguage: 'it-IT',
  publisher: {
    '@id': `${site.url}/#person`
  }
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': pageSchemaType,
  '@id': `${canonical}#webpage`,
  name: title,
  url: canonical,
  description,
  inLanguage: 'it-IT',
  isPartOf: {
    '@id': `${site.url}/#website`
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: `${site.url}/social-card.png`,
    width: 2048,
    height: 1152
  },
  mainEntity: {
    '@id': `${site.url}/#person`
  }
};

const structuredData = [personSchema, websiteSchema, webPageSchema, ...structuredDataExtra];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.name} />
    <meta name="publisher" content={site.name} />
    <meta name="image" content={`${site.url}/social-card.png`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="300x300" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMS profile summary" />
    {socialUrls.map((url) => <link rel="me" href={url} />)}
    <meta property="og:type" content={ogType} />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Enrico" />
        <meta property="profile:last_name" content="Toso" />
        <meta property="profile:username" content="enricopaolotoso" />
      </>
    )}
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Enrico Toso — Digital Builder a Padova" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social-card.png`} />
    <meta name="theme-color" content="#0b1220" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9ZCGFDD1KW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-9ZCGFDD1KW');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
