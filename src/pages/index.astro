---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import FinderWindow from '../components/windows/FinderWindow.astro';
import ProjectsWindow from '../components/windows/ProjectsWindow.astro';
import PhotosWindow from '../components/windows/PhotosWindow.astro';
const apps = [
  { id: 'finder', label: 'Finder', icon: 'finder.png', fallback: '🗂️' },
  { id: 'mail', label: 'Mail', icon: 'mail.png', fallback: '✉️' },
  { id: 'notes', label: 'Note', icon: 'notes.png', fallback: '📝' },
  { id: 'photos', label: 'Foto', icon: 'photos.png', fallback: '🌈' },
  { id: 'terminal', label: 'Terminale', icon: 'terminal.png', fallback: '⌘' },
  { id: 'settings', label: 'Impostazioni', icon: 'settings.png', fallback: '⚙️' },
  { id: 'launchpad', label: 'App', icon: 'launchpad.png', fallback: '✳︎' },
  { id: 'trash', label: 'Cestino', icon: 'trash.png', fallback: '🗑️' }
];
---
<BaseLayout>
  <main id="desktop" class="desktop-shell" data-active-app="Finder">
    <div class="wallpaper" aria-hidden="true"></div>
    <div id="loader" class="loader" role="status" aria-live="polite" aria-label="Caricamento portfolio">
      <div class="loader-card">
        <div class="loader-spinner"></div>
        <p>Preparazione desktop...</p>
      </div>
    </div>

    <MenuBar />

    <section class="desktop-items" aria-label="Elementi desktop">
      {site.desktopItems.map((item) => (
        <button class={`desktop-item ${item.type}`} data-open={item.app} data-item={item.id} style={`--x:${item.x}px;--y:${item.y}px`}>
          <span class="desktop-thumb" aria-hidden="true">
            {item.type === 'folder' && <img src="/apple-icons/folder.png" alt="" onerror="this.style.display='none'" />}
            {item.type === 'document' && <span class="doc-thumb">MD</span>}
            {item.type === 'video' && <span class="video-thumb">▶</span>}
            {item.type === 'pdf' && <span class="pdf-thumb">PDF</span>}
            {item.type === 'note' && <span class="note-thumb">Nota</span>}
            {item.type === 'appfile' && <span class="app-thumb">N</span>}
          </span>
          <span class="desktop-label">{item.title}</span>
        </button>
      ))}
    </section>

    <section id="tour" class="tour" role="dialog" aria-modal="true" aria-labelledby="tourTitle" aria-describedby="tourText" aria-hidden="true">
      <div class="tour-card" tabindex="-1">
        <h2 id="tourTitle" data-tour-title>Benvenuto nel desktop di Enrico</h2>
        <p id="tourText" data-tour-body>Questo portfolio è stato reimmaginato come un desktop Mac. Ogni app, cartella e file apre una parte diversa del percorso di Enrico.</p>
        <div class="tour-actions">
          <button id="skipTour" class="text-btn" type="button" data-tour-skip>Salta guida</button>
          <div class="tour-nav">
            <button id="prevTour" class="secondary-btn" type="button" data-tour-back>Indietro</button>
            <button id="nextTour" class="primary-btn" type="button" data-tour-next>Avanti</button>
          </div>
        </div>
        <small id="tourStep" data-tour-step>Step 1 di 5</small>
      </div>
    </section>

    <div id="windowLayer" class="window-layer">
      <FinderWindow />
      <ProjectsWindow />

      <article class="mac-window notes-window" data-window="notes" data-app-title="Note" style="--left: 18vw; --top: 13vh; --w: 900px; --h: 620px;" role="dialog" aria-label="Note" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Note"></button><button type="button" data-minimize aria-label="Riduci Note"></button><button type="button" data-maximize aria-label="Ingrandisci Note"></button></div><strong>Note</strong><button class="info-btn" type="button" data-focus-note-search aria-label="Cerca nelle note">⌕</button></div>
        <div class="notes-layout">
          <aside class="notes-folders" aria-label="Cartelle note"><button type="button" class="active" data-note-folder="all">📁 Tutte</button><button type="button" data-note-folder="Profilo">📁 Profilo</button><button type="button" data-note-folder="Archivio">📁 Archivio</button></aside>
          <div class="notes-list">
            <label class="notes-search"><span class="sr-only">Cerca nelle note</span><input type="search" placeholder="Cerca note" data-notes-search /></label>
            {site.notes.map((n, i) => <button type="button" class={i===0?'active':''} data-note={n.id} data-note-folder={n.folder} data-note-title={n.title} data-note-body={n.body}><strong>{n.title}</strong><small>{n.body.slice(0,82)}...</small></button>)}
            <p class="notes-empty" hidden>Nessuna nota trovata.</p>
          </div>
          <article class="note-body">
            <h2 id="noteTitle">{site.notes[0].title}</h2>
            <p id="noteBody">{site.notes[0].body}</p>
          </article>
        </div>
      </article>

      <PhotosWindow />

      <article class="mac-window mail-window" data-window="mail" data-app-title="Mail" style="--left: 17vw; --top: 17vh; --w: 920px; --h: 600px;" role="dialog" aria-label="Contatti" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Mail"></button><button type="button" data-minimize aria-label="Riduci Mail"></button><button type="button" data-maximize aria-label="Ingrandisci Mail"></button></div><strong>Mail</strong></div>
        <div class="mail-layout">
          <aside><button type="button" class="active">📥 Opportunità</button><button type="button" disabled>⭐ Collaborazioni</button><button type="button" disabled>📤 In uscita</button></aside>
          <article class="mail-compose">
            <div><span>A:</span><strong>{site.name}</strong></div>
            <div><span>Oggetto:</span><strong>Nuova opportunità / collaborazione</strong></div>
            <p>Per progetti digitali, branding, siti web, e-commerce, contenuti, AI workflow o nuove opportunità imprenditoriali.</p>
            {site.email ? (
              <div class="mail-actions">
                <a href={`mailto:${site.email}`}>Apri email</a>
                <button type="button" data-copy={site.email}>Copia email</button>
                {site.socials.linkedin && <a href={site.socials.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>}
              </div>
            ) : (
              <div class="contact-pending" role="status">
                <strong>Contatti in aggiornamento</strong>
                <p>I recapiti pubblici non sono ancora stati configurati. Questa sezione verrà attivata appena saranno disponibili.</p>
              </div>
            )}
          </article>
        </div>
      </article>

      <article class="mac-window terminal-window" data-window="terminal" data-terminal data-app-title="Terminale" style="--left: 25vw; --top: 19vh; --w: 760px; --h: 480px;" role="dialog" aria-label="Terminale" aria-modal="false">
        <div class="window-chrome dark"><div class="traffic"><button type="button" data-close aria-label="Chiudi Terminale"></button><button type="button" data-minimize aria-label="Riduci Terminale"></button><button type="button" data-maximize aria-label="Ingrandisci Terminale"></button></div><strong>Terminale</strong></div>
        <div class="terminal-body" id="terminalOutput" data-terminal-output aria-live="polite">
          <p>Last login: oggi su portfolio</p>
          <p>Digita <code>help</code>, <code>about</code>, <code>skills</code>, <code>projects</code>, <code>contact</code> o <code>clear</code>.</p>
          <label><span>enrico@portfolio ~ %</span><input id="terminalInput" data-terminal-input autocomplete="off" aria-label="Comando terminale" spellcheck="false" /></label>
        </div>
      </article>

      <article class="mac-window settings-window" data-window="settings" data-app-title="Impostazioni" style="--left: 19vw; --top: 12vh; --w: 900px; --h: 620px;" role="dialog" aria-label="Impostazioni" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Impostazioni"></button><button type="button" data-minimize aria-label="Riduci Impostazioni"></button><button type="button" data-maximize aria-label="Ingrandisci Impostazioni"></button></div><strong>Impostazioni</strong></div>
        <div class="settings-layout">
          <aside><button type="button" class="active" data-settings-section="general">Generali</button><button type="button" data-settings-section="skills">Competenze</button><button type="button" data-settings-section="contact">Contatto</button></aside>
          <section data-settings-panel="general">
            <div class="profile-card"><div class="avatar">E</div><div><h2>{site.name}</h2><p>{site.role} · {site.location}</p></div></div>
            <div class="settings-grid">
              <div><span>Ruolo</span><strong>{site.role}</strong></div>
              <div><span>Base</span><strong>{site.location}</strong></div>
              <div><span>Focus</span><strong>Brand / Web / Content / AI</strong></div>
              <div><span>Stato</span><strong>Portfolio operativo</strong></div>
            </div>
          </section>
          <section data-settings-panel="skills" hidden>
            <h2>Competenze operative</h2>
            <div class="module-list">{site.modules.map((m) => <div><strong>{m.name}</strong><p>{m.text}</p><span aria-label={`${m.value} su 100`}><i style={`width:${m.value}%`}></i></span></div>)}</div>
          </section>
          <section data-settings-panel="contact" hidden>
            <h2>Contatti</h2>
            <div class="contact-pending"><strong>Recapiti pubblici in aggiornamento</strong><p>Il portfolio non espone indirizzi o profili non verificati.</p></div>
          </section>
        </div>
      </article>

      <article class="mac-window readme-window" data-window="readme" data-app-title="README.md" style="--left: 28vw; --top: 16vh; --w: 680px; --h: 560px;" role="dialog" aria-label="README" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi README"></button><button type="button" data-minimize aria-label="Riduci README"></button><button type="button" data-maximize aria-label="Ingrandisci README"></button></div><strong>README.md</strong><button class="info-btn" type="button" aria-label="Informazioni">ⓘ</button></div>
        <article class="readme-body">
          <h1>README.md</h1>
          <p>Questo portfolio è un desktop interattivo. Apri app, cartelle e file per esplorare progetti, competenze, contenuti e canali di contatto.</p>
          <h2>Da dove iniziare</h2>
          <ul><li><strong>Finder</strong> raccoglie progetti e archivio.</li><li><strong>Note</strong> contiene bio, manifesto e timeline.</li><li><strong>Foto</strong> mostra contenuti e progetti visivi.</li><li><strong>Mail</strong> mostra i recapiti quando sono disponibili.</li><li><strong>Terminale</strong> contiene comandi rapidi ed easter egg.</li></ul>
          <p>Premi <kbd>Esc</kbd> per chiudere la finestra in primo piano.</p>
        </article>
      </article>

      <article class="launchpad" data-window="launchpad" data-app-title="App" role="dialog" aria-label="Launchpad" aria-modal="true" aria-hidden="true">
        <div class="launchpad-panel"><label><span class="sr-only">Cerca applicazione</span><input type="search" placeholder="Cerca app" data-launchpad-search /></label><div>{apps.map((app) => <button type="button" data-open={app.id} data-app-label={app.label}><span class="dock-icon"><img src={`/apple-icons/${app.icon}`} alt="" onerror="this.style.display='none'"/><b>{app.fallback}</b></span><small>{app.label}</small></button>)}</div><p class="launchpad-empty" hidden>Nessuna app trovata.</p></div>
      </article>

      <article class="mac-window trash-window" data-window="trash" data-app-title="Cestino" style="--left: 36vw; --top: 28vh; --w: 430px; --h: 270px;" role="dialog" aria-label="Cestino" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Cestino"></button><button type="button" data-minimize aria-label="Riduci Cestino"></button><button type="button" data-maximize aria-label="Ingrandisci Cestino"></button></div><strong>Cestino</strong></div>
        <div class="trash-body"><h2>Cestino vuoto</h2><p>Mediocrità, scuse e idee medie sono già state eliminate.</p></div>
      </article>
    </div>

    <Dock />
  </main>
  <script is:inline type="module" src="/desktop.js"></script>
</BaseLayout>
