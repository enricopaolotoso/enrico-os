---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import FinderWindow from '../components/windows/FinderWindow.astro';
import ProjectsWindow from '../components/windows/ProjectsWindow.astro';
import PhotosWindow from '../components/windows/PhotosWindow.astro';
import SpotifyWindow from '../components/windows/SpotifyWindow.astro';
import PreviewWindow from '../components/windows/PreviewWindow.astro';
import QuickTimeWindow from '../components/windows/QuickTimeWindow.astro';
import SafariWindow from '../components/windows/SafariWindow.astro';
import { fileSystem, flattenFileSystem, type FileSystemItem } from '../data/filesystem';

const desktopItems = fileSystem.children ?? [];
const searchableFileSystemItems = flattenFileSystem().filter((item) => item.id !== fileSystem.id);
const fileSystemJson = JSON.stringify(fileSystem).replace(/</g, '\\u003c');

const desktopMark = (item: FileSystemItem) => {
  if (item.icon) return item.icon;
  if (item.type === 'image') return 'IMG';
  if (item.type === 'video') return '▶';
  if (item.type === 'document') return 'MD';
  if (item.type === 'pdf') return 'PDF';
  if (item.type === 'link') return '↗';
  if (item.type === 'note') return 'Nota';
  if (item.type === 'audio') return '♪';
  if (item.type === 'playlist') return '♫';
  if (item.type === 'app') return 'APP';
  return '';
};

const desktopAspect = (item: FileSystemItem) => {
  if (item.type === 'app') return 'square';
  if (item.type === 'folder') return 'folder';
  if (item.type === 'video') return item.aspectRatio ?? 'horizontal';
  if (item.type === 'image') return item.aspectRatio ?? 'auto';
  if (item.type === 'pdf' || item.type === 'document' || item.type === 'note') return item.aspectRatio ?? 'portrait';
  if (item.type === 'link' || item.type === 'audio' || item.type === 'playlist') return item.aspectRatio ?? 'horizontal';
  return item.aspectRatio ?? 'auto';
};

const desktopItemClass = (item: FileSystemItem) => [
  'desktop-item',
  `desktop-item--${item.type}`,
  `desktop-item--${desktopAspect(item)}`,
  item.thumbnail ? 'has-thumbnail' : ''
].filter(Boolean).join(' ');

const apps = [
  { id: 'finder', label: 'Finder', icon: 'finder.png', fallback: '🗂️' },
  { id: 'projects', label: 'Progetti', icon: 'folder.png', fallback: 'P' },
  { id: 'mail', label: 'Mail', icon: 'mail.png', fallback: '✉️' },
  { id: 'notes', label: 'Note', icon: 'notes.png', fallback: '📝' },
  { id: 'photos', label: 'Foto', icon: 'photos.png', fallback: '🌈' },
  { id: 'terminal', label: 'Terminale', icon: 'terminal.png', fallback: '⌘' },
  { id: 'settings', label: 'Informazioni', icon: 'settings.png', fallback: '⚙️' },
  { id: 'spotify', label: 'Spotify', icon: 'spotify.svg', fallback: 'S' },
  { id: 'launchpad', label: 'App', icon: 'launchpad.png', fallback: '✳︎' },
  { id: 'trash', label: 'Cestino', icon: 'trash.png', fallback: '🗑️' },
  { id: 'instagram', label: 'Instagram', icon: 'app_instagram.webp', fallback: '◎', url: site.socials.instagram, social: 'instagram' },
  { id: 'tiktok', label: 'TikTok', icon: 'app_tiktok.webp', fallback: '♪', url: site.socials.tiktok, social: 'tiktok' },
  { id: 'linkedin', label: 'LinkedIn', icon: 'app_linkedin.webp', fallback: 'in', url: site.socials.linkedin, social: 'linkedin' },
  { id: 'youtube', label: 'YouTube', icon: 'app_youtube.webp', fallback: '▶', url: site.socials.youtube, social: 'youtube' }
];
---
<BaseLayout>
  <main id="desktop" class="desktop-shell" data-active-app="Desktop">
    <h1 class="sr-only">Enrico Toso — Digital Builder a Padova</h1>
    <section class="seo-content sr-only" aria-label="Profilo di Enrico Toso">
      <h2>Portfolio personale di Enrico Toso</h2>
      <p>
        Enrico Toso è un digital builder di Padova. Il suo nome completo è Enrico Paolo Toso.
        Lavora su branding, siti web, e-commerce, contenuti, marketing digitale, intelligenza
        artificiale e progetti digitali.
      </p>
      <p>
        È collegato a Netmarket e Raviez e costruisce progetti che uniscono identità, prodotto,
        comunicazione, tecnologia e distribuzione. Questo sito è il portfolio personale di
        Enrico Toso.
      </p>
      <h2>Archivio del portfolio</h2>
      <ul>
        {searchableFileSystemItems.map((item) => (
          <li>
            <strong>{item.name}</strong>
            {item.description ? ` — ${item.description}` : ''}
          </li>
        ))}
      </ul>
    </section>
    <script id="filesystem-data" type="application/json" is:inline set:html={fileSystemJson} />
    <div class="wallpaper" aria-hidden="true"></div>

    <section
      id="mobileLockScreen"
      class="mobile-lock-screen"
      role="button"
      tabindex="0"
      aria-label="Tocca per entrare nel portfolio"
    >
      <div class="mobile-lock-content">
        <div class="mobile-lock-date" id="mobileLockDate">Oggi</div>
        <time class="mobile-lock-time" id="mobileLockTime">--:--</time>

        <article class="ios-notification" aria-label="Notifica di benvenuto da Enrico Toso">
          <div class="ios-notification-avatar" aria-hidden="true">
            <img src="/images/foto-profilo-enricotoso.jpg" alt="" />
            <span class="ios-notification-app-icon">●</span>
          </div>
          <div class="ios-notification-body">
            <header>
              <strong>Enrico Toso</strong>
              <small>adesso</small>
            </header>
            <p>Benvenut* nel mio computer. Tocca lo schermo per entrare.</p>
          </div>
        </article>
      </div>

      <p class="mobile-lock-enter">tap to enter</p>
    </section>

    <div id="loader" class="loader" role="status" aria-live="polite" aria-label="Caricamento portfolio">
      <div class="loader-card">
        <div class="loader-spinner"></div>
        <p>Preparazione desktop...</p>
      </div>
    </div>

    <MenuBar />

    <section class="desktop-items" aria-label="Elementi desktop" data-tour-target="desktop">
      {desktopItems.map((item, index) => (
        <button
          type="button"
          class={desktopItemClass(item)}
          data-item-id={item.id}
          data-tour-target={item.id === 'readme' ? 'readme' : undefined}
          data-external-url={item.external ? item.url : undefined}
          style={`--x:${52 + ((index * 173) % 1030)}px;--y:${70 + ((index * 137) % 330)}px`}
          aria-label={`Apri ${item.name}`}
        >
          <span class="desktop-item__visual desktop-thumb" aria-hidden="true">
            {item.type === 'folder' ? (
              <img class="desktop-item__folder-icon" src="/apple-icons/folder.png" alt="" />
            ) : item.type === 'video' ? (
              <>
                {item.thumbnail ? <img src={item.thumbnail} alt="" loading="eager" /> : <span class="desktop-item__fallback">{desktopMark(item)}</span>}
                <span class="desktop-item__play">▶</span>
              </>
            ) : item.type === 'image' && item.thumbnail ? (
              <img src={item.thumbnail} alt="" loading="eager" />
            ) : item.type === 'document' || item.type === 'pdf' ? (
              <span class="desktop-item__sheet">
                <span>{item.type === 'pdf' ? 'PDF' : item.icon || 'MD'}</span>
              </span>
            ) : item.type === 'note' ? (
              <span class="desktop-item__note">
                <i></i><i></i><i></i>
              </span>
            ) : item.type === 'link' ? (
              <span class="desktop-item__link-card">
                <strong>{desktopMark(item)}</strong>
                <small>URL</small>
              </span>
            ) : item.type === 'audio' || item.type === 'playlist' ? (
              <span class="desktop-item__audio-card">
                <strong>{desktopMark(item)}</strong>
                <small>{item.type === 'playlist' ? 'Playlist' : 'Audio'}</small>
              </span>
            ) : item.thumbnail ? (
              <img src={item.thumbnail} alt="" loading="eager" />
            ) : (
              <span class="desktop-item__fallback">{desktopMark(item)}</span>
            )}
          </span>
          <span class="desktop-label">{item.name}</span>
        </button>
      ))}
    </section>

    <section id="tour" class="tour" role="dialog" aria-modal="true" aria-labelledby="tourTitle" aria-describedby="tourText" aria-hidden="true">
      <div class="tour-overlay" data-tour-overlay></div>
      <div class="tour-highlight" data-tour-highlight hidden></div>
      <div id="tour-popover" class="tour-card tour-popover" tabindex="-1" data-tour-popover>
        <small class="tour-progress" id="tourStep" data-tour-step>1 / 9</small>
        <h2 id="tourTitle" data-tour-title>Benvenuto</h2>
        <p id="tourText" data-tour-body>Questo sito funziona come un desktop interattivo.</p>
        <div class="tour-actions">
          <button id="skipTour" class="text-btn" type="button" data-tour-skip>Salta guida</button>
          <div class="tour-nav">
            <button id="prevTour" class="secondary-btn" type="button" data-tour-back>Indietro</button>
            <button id="nextTour" class="primary-btn" type="button" data-tour-next>Avanti</button>
          </div>
        </div>
      </div>
    </section>

    <div id="windowLayer" class="window-layer">
      <FinderWindow />
      <ProjectsWindow />

      <article class="mac-window notes-window" data-window="notes" data-app-title="Note" style="--left: 14vw; --top: 10vh; --w: 1040px; --h: 660px;" role="dialog" aria-label="Note" aria-modal="false">
        <div class="window-chrome">
          <div class="traffic"><button type="button" data-close aria-label="Chiudi Note"></button><button type="button" data-minimize aria-label="Riduci Note"></button><button type="button" data-maximize aria-label="Ingrandisci Note"></button></div>
          <strong data-notes-window-title>Note</strong>
          <button class="info-btn" type="button" data-focus-note-search aria-label="Cerca nelle note">⌕</button>
        </div>

        <div class="notes-app">
          <section class="notes-library-screen is-active" data-notes-screen="library">
            <main class="notes-library-main">
              <header class="notes-library-header">
                <div>
                  <h2 data-notes-folder-title>Tutte le note</h2>
                  <p><span data-notes-count>{site.notes.length}</span> note</p>
                </div>
                <label class="notes-search">
                  <span class="sr-only">Cerca nelle note</span>
                  <input type="search" placeholder="Cerca note" data-notes-search />
                </label>
              </header>

              <div class="notes-list" data-notes-list>
                {site.notes.map((n) => (
                  <button type="button" data-note={n.id} data-note-title={n.title} data-note-body={n.body}>
                    <strong>{n.title}</strong>
                    <small>{n.body.replace(/\n+/g, ' ').slice(0, 145)}...</small>
                  </button>
                ))}
                <p class="notes-empty" hidden>Nessuna nota trovata.</p>
              </div>
            </main>
          </section>

          <article class="note-reader-screen" data-notes-screen="reader">
            <header class="note-reader-header">
              <button type="button" class="note-back-button" data-note-back aria-label="Torna all’elenco delle note">‹</button>
              <div>
                <h2 id="noteTitle">{site.notes[0].title}</h2>
                <p>Nota</p>
              </div>
            </header>
            <div class="note-reader-content">
              <time>{new Intl.DateTimeFormat('it-IT', { dateStyle: 'long' }).format(new Date())}</time>
              <p id="noteBody">{site.notes[0].body}</p>
            </div>
          </article>
        </div>
      </article>

      <PhotosWindow />
      <SpotifyWindow />
      <PreviewWindow />
      <QuickTimeWindow />
      <SafariWindow />

      <article class="mac-window mail-window" data-window="mail" data-app-title="Mail" style="--left: 17vw; --top: 17vh; --w: 920px; --h: 600px;" role="dialog" aria-label="Contatti" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Mail"></button><button type="button" data-minimize aria-label="Riduci Mail"></button><button type="button" data-maximize aria-label="Ingrandisci Mail"></button></div><strong>Mail</strong></div>
        <div class="mail-layout">
          <aside>
            <button type="button" class="active">✉️ Nuovo messaggio</button>
            <div class="mail-sidebar-note">
              <strong>Contatta Enrico</strong>
              <p>Puoi scrivermi direttamente da qui. Riceverò il messaggio nella mia casella personale.</p>
            </div>
          </aside>
          <form
            class="mail-compose contact-form"
            action={`https://formsubmit.co/ajax/${site.email}`}
            method="POST"
            data-contact-form
          >
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" class="sr-only" tabindex="-1" autocomplete="off" />

            <div class="mail-recipient">
              <span>A:</span>
              <strong>Enrico Toso</strong>
            </div>

            <label>
              <span>La tua email</span>
              <input type="email" name="email" placeholder="nome@esempio.com" autocomplete="email" required />
            </label>

            <label>
              <span>Oggetto</span>
              <input type="text" name="_subject" placeholder="Di cosa vuoi parlarmi?" maxlength="140" required />
            </label>

            <label class="mail-message-field">
              <span>Messaggio</span>
              <textarea name="message" placeholder="Scrivi qui il tuo messaggio…" minlength="10" required></textarea>
            </label>

            <footer class="contact-form-footer">
              <p>I dati inseriti saranno utilizzati esclusivamente per rispondere al messaggio.</p>
              <button type="submit" class="contact-submit">Invia messaggio</button>
            </footer>

            <p class="contact-form-status" data-contact-status aria-live="polite"></p>
          </form>
        </div>
      </article>

      <article class="mac-window terminal-window" data-window="terminal" data-terminal data-app-title="Terminale" style="--left: 25vw; --top: 19vh; --w: 760px; --h: 480px;" role="dialog" aria-label="Terminale" aria-modal="false">
        <div class="window-chrome dark"><div class="traffic"><button type="button" data-close aria-label="Chiudi Terminale"></button><button type="button" data-minimize aria-label="Riduci Terminale"></button><button type="button" data-maximize aria-label="Ingrandisci Terminale"></button></div><strong>Terminale</strong></div>
        <div class="terminal-body" id="terminalOutput" data-terminal-output aria-live="polite">
          <p>Last login: oggi su portfolio</p>
          <p>Digita <code>help</code>, <code>about</code>, <code>skills</code>, <code>projects</code>, <code>contact</code> o <code>clear</code>.</p>
          <label><span>enrico@portfolio ~ %</span><input id="terminalInput" data-terminal-input autocomplete="off" aria-label="Comando terminale" spellcheck="false" /></label>
        </div>
      </article>

      <article class="mac-window settings-window about-window" data-window="settings" data-app-title="Informazioni" style="--left: 28vw; --top: 8vh; --w: 620px; --h: 680px;" role="dialog" aria-label="Informazioni su Enrico Toso" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Informazioni"></button><button type="button" data-minimize aria-label="Riduci Informazioni"></button><button type="button" data-maximize aria-label="Ingrandisci Informazioni"></button></div><strong>Informazioni</strong></div>
        <article class="about-profile">
          <div class="about-profile-photo">
            <span aria-hidden="true">E</span>
            <img
              src="/images/foto-profilo-enricotoso.jpg"
              alt="Enrico Toso"
              onerror="this.remove()"
            />
          </div>
          <h2>Enrico Toso</h2>
          <p class="about-profile-established">Est. 2004</p>

          <div class="about-profile-copy">
            <p>
              Sono Enrico Toso, digital builder di Padova. Costruisco brand, siti web,
              e-commerce, contenuti e progetti digitali combinando comunicazione,
              marketing, tecnologia e intelligenza artificiale.
            </p>
            <p>
              Il mio nome completo è Enrico Paolo Toso. Questo portfolio raccoglie una
              parte del mio percorso tra Netmarket, Raviez e nuove sperimentazioni,
              con un approccio che unisce identità, prodotto, comunicazione e distribuzione.
            </p>
          </div>

          <nav class="about-profile-socials" aria-label="Profili social di Enrico Toso">
            <a href={site.socials.instagram} target="_blank" rel="me noreferrer">Instagram</a>
            <a href={site.socials.linkedin} target="_blank" rel="me noreferrer">LinkedIn</a>
            <a href={site.socials.youtube} target="_blank" rel="me noreferrer">YouTube</a>
          </nav>

          <footer>© {new Date().getFullYear()} Enrico Toso</footer>
        </article>
      </article>

      <article
        class="mac-window launchpad"
        data-window="launchpad"
        data-app-title="App"
        style="--left: 16vw; --top: 11vh; --w: 840px; --h: 610px;"
        role="dialog"
        aria-label="Launchpad"
        aria-modal="false"
        aria-hidden="true"
      >
        <div class="window-chrome launchpad-chrome">
          <strong>App</strong>
        </div>
        <div class="launchpad-panel">
          <label class="launchpad-search">
            <span class="sr-only">Cerca applicazione</span>
            <input type="search" placeholder="Cerca applicazioni" data-launchpad-search />
          </label>
          <div class="launchpad-grid">
            {apps.map((app) => (
              <button
                type="button"
                data-open={app.url ? undefined : app.id}
                data-url={app.url || undefined}
                data-app-label={app.label}
                aria-label={`Apri ${app.label}`}
              >
                <span class={`launchpad-icon ${app.social ? `is-social ${app.social}` : ''}`} aria-hidden="true">
                  {app.icon ? (
                    <img src={`/apple-icons/${app.icon}`} alt="" onerror="this.style.display='none'"/>
                  ) : null}
                  <b>{app.fallback}</b>
                </span>
                <small>{app.label}</small>
              </button>
            ))}
          </div>
          <p class="launchpad-empty" hidden>Nessuna app trovata.</p>
        </div>
      </article>

      <article class="mac-window trash-window" data-window="trash" data-app-title="Cestino" style="--left: 36vw; --top: 28vh; --w: 430px; --h: 270px;" role="dialog" aria-label="Cestino" aria-modal="false">
        <div class="window-chrome"><div class="traffic"><button type="button" data-close aria-label="Chiudi Cestino"></button><button type="button" data-minimize aria-label="Riduci Cestino"></button><button type="button" data-maximize aria-label="Ingrandisci Cestino"></button></div><strong>Cestino</strong></div>
        <div class="trash-body"><h2>Cestino vuoto</h2><p>Mediocrità, scuse e idee medie sono già state eliminate.</p></div>
      </article>
    </div>

    <Dock />
  </main>
  <script is:inline type="module" src="/desktop.js"></script>
</BaseLayout>
