---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `404 | ${site.name}`;
const description = 'Pagina non trovata nel portfolio desktop di Enrico Toso.';
---
<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  canonical={`${site.url}/404`}
  ogUrl={`${site.url}/404`}
  pageSchemaType="WebPage"
>
  <main class="not-found-shell" aria-labelledby="not-found-title">
    <div class="not-found-wallpaper" aria-hidden="true"></div>

    <header class="not-found-menu" aria-label="Barra menu 404">
      <div>
        <span aria-hidden="true"></span>
        <strong>Finder</strong>
        <span>File</span>
        <span>Vista</span>
        <span>Vai</span>
      </div>
      <time datetime="2026-08-01">404 non trovato</time>
    </header>

    <section class="not-found-window" role="dialog" aria-label="Pagina non trovata">
      <div class="not-found-chrome">
        <div class="not-found-traffic" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <strong>Elemento non trovato</strong>
      </div>

      <div class="not-found-content">
        <div class="not-found-icon" aria-hidden="true">
          <span>?</span>
        </div>
        <p class="not-found-code">Errore 404</p>
        <h1 id="not-found-title">Questo file non è nel Desktop.</h1>
        <p>
          Il collegamento potrebbe essere stato spostato, rinominato o eliminato. Puoi tornare al
          portfolio principale e continuare l’esplorazione da Finder.
        </p>
        <nav class="not-found-actions" aria-label="Azioni pagina 404">
          <a class="not-found-primary" href="/">Torna al Desktop</a>
          <a href={`mailto:${site.email}`}>Scrivi a Enrico</a>
        </nav>
      </div>
    </section>
  </main>

  <style>
    .not-found-shell {
      position: relative;
      width: 100vw;
      height: 100dvh;
      overflow: hidden;
      color: #1d1d1f;
      background: #050b16;
    }

    .not-found-wallpaper {
      position: absolute;
      inset: 0;
      background: #444 url("/images/sfondo-desktop.png") center/cover no-repeat;
    }

    .not-found-menu {
      position: absolute;
      inset: 0 0 auto;
      z-index: 2;
      height: var(--menu-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      color: rgba(255, 255, 255, .96);
      background: rgba(255, 255, 255, .28);
      border-bottom: 1px solid rgba(255, 255, 255, .12);
      backdrop-filter: blur(28px) saturate(1.65);
      -webkit-backdrop-filter: blur(28px) saturate(1.65);
      text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
      font-size: 13px;
    }

    .not-found-menu div {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }

    .not-found-menu span,
    .not-found-menu strong,
    .not-found-menu time {
      white-space: nowrap;
    }

    .not-found-window {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 1;
      width: min(560px, calc(100vw - 32px));
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .58);
      border-radius: 14px;
      background: rgba(248, 248, 250, .82);
      box-shadow:
        0 42px 110px rgba(0, 0, 0, .42),
        0 14px 40px rgba(0, 0, 0, .22),
        inset 0 1px 0 rgba(255, 255, 255, .7);
      backdrop-filter: blur(34px) saturate(1.85);
      -webkit-backdrop-filter: blur(34px) saturate(1.85);
      transform: translate(-50%, -50%);
    }

    .not-found-chrome {
      position: relative;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
      border-bottom: 1px solid rgba(60, 60, 67, .12);
      background: linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(242, 242, 247, .46));
      user-select: none;
    }

    .not-found-chrome strong {
      max-width: calc(100% - 160px);
      overflow: hidden;
      font-size: 13.5px;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .not-found-traffic {
      position: absolute;
      left: 16px;
      display: flex;
      gap: 8px;
    }

    .not-found-traffic span {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 .5px rgba(0, 0, 0, .2);
    }

    .not-found-traffic span:nth-child(1) { background: var(--red); }
    .not-found-traffic span:nth-child(2) { background: var(--yellow); }
    .not-found-traffic span:nth-child(3) { background: var(--green); }

    .not-found-content {
      display: grid;
      justify-items: center;
      padding: 48px 42px 42px;
      text-align: center;
    }

    .not-found-icon {
      width: 92px;
      height: 92px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border-radius: 23px;
      background: linear-gradient(145deg, #fff, #d7dbe6);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .18);
      color: #0a84ff;
      font-size: 48px;
      font-weight: 800;
    }

    .not-found-code {
      margin: 0 0 8px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .not-found-content h1 {
      max-width: 420px;
      margin: 0;
      color: #1d1d1f;
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.03;
      letter-spacing: 0;
    }

    .not-found-content p:not(.not-found-code) {
      max-width: 430px;
      margin: 16px 0 0;
      color: #51515a;
      font-size: 16px;
      line-height: 1.55;
    }

    .not-found-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 28px;
    }

    .not-found-actions a {
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 16px;
      border-radius: 10px;
      background: rgba(118, 118, 128, .13);
      color: #1d1d1f;
      font-weight: 700;
      text-decoration: none;
    }

    .not-found-actions a:hover {
      background: rgba(118, 118, 128, .2);
    }

    .not-found-actions .not-found-primary {
      color: #fff;
      background: var(--blue);
    }

    .not-found-actions .not-found-primary:hover {
      background: #006ee6;
    }

    @media (max-width: 640px) {
      .not-found-menu span:nth-of-type(n+3) {
        display: none;
      }

      .not-found-window {
        top: calc(var(--menu-height) + 18px);
        transform: translateX(-50%);
        width: calc(100vw - 20px);
      }

      .not-found-chrome {
        height: 52px;
      }

      .not-found-traffic span {
        width: 18px;
        height: 18px;
      }

      .not-found-content {
        padding: 38px 24px 30px;
      }

      .not-found-icon {
        width: 78px;
        height: 78px;
        border-radius: 20px;
        font-size: 40px;
      }

      .not-found-actions {
        width: 100%;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
