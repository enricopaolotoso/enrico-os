---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `404 | ${site.name}`;
const description = 'Pagina non trovata nel mio portfolio desktop.';

const popupPositions = [
  [-430, -220], [-260, -260], [-80, -230], [160, -250], [360, -210],
  [-520, -80], [-330, -90], [-120, -80], [180, -90], [420, -70],
  [-470, 70], [-260, 55], [-60, 70], [170, 65], [390, 85],
  [-420, 210], [-230, 220], [-20, 210], [210, 220], [430, 205],
  [-320, 330], [-110, 330], [120, 330], [330, 320]
];

const errorWindows = popupPositions.map(([dx, dy], index) => ({
  id: index + 1,
  dx,
  dy,
  mobileDx: Math.round(dx * 0.28),
  mobileDy: Math.round(dy * 0.36),
  title: index % 3 === 0 ? 'System Error' : index % 3 === 1 ? 'Finder Error' : '404 Alert',
  message: index % 4 === 0
    ? 'Il file richiesto non esiste in questa directory.'
    : index % 4 === 1
      ? 'Percorso non trovato. Verifica il collegamento.'
      : index % 4 === 2
        ? 'Errore 404. Risorsa mancante nel Desktop.'
        : 'Impossibile completare l’operazione.'
}));
---
<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  canonical={`${site.url}/404`}
  ogUrl={`${site.url}/404`}
  pageSchemaType="WebPage"
>
  <main class="not-found-shell" aria-labelledby="not-found-title">
    <div class="not-found-wallpaper" aria-hidden="true"></div>

    <header class="not-found-menu" aria-label="Barra menu 404">
      <div>
        <span aria-hidden="true"></span>
        <strong>Finder</strong>
        <span>File</span>
        <span>Vista</span>
        <span>Vai</span>
      </div>
      <time datetime="2026-08-01">404 non trovato</time>
    </header>

    <div class="error-window-layer" aria-hidden="true">
      {errorWindows.map((item, index) => (
        <article
          class="error-popup"
          style={`--i:${index}; --dx:${item.dx}px; --dy:${item.dy}px; --mx:${item.mobileDx}px; --my:${item.mobileDy}px; --r:${(index % 7) - 3}deg; --z:${10 + index};`}
        >
          <div class="error-popup-chrome">
            <div class="not-found-traffic" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <strong>{item.title}</strong>
          </div>
          <div class="error-popup-body">
            <div class="error-popup-icon">!</div>
            <div>
              <strong>Errore #{String(item.id).padStart(2, '0')}</strong>
              <p>{item.message}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="not-found-window" role="dialog" aria-label="Pagina non trovata">
      <div class="not-found-chrome">
        <div class="not-found-traffic" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <strong>Elemento non trovato</strong>
      </div>

      <div class="not-found-content">
        <div class="not-found-icon" aria-hidden="true">
          <span>!</span>
        </div>
        <p class="not-found-code">Errore 404</p>
        <h1 id="not-found-title">Errore. Errore. Errore.</h1>
        <p>
          Il collegamento richiesto ha generato troppe finestre. Puoi chiudere la scena
          tornando al Desktop principale.
        </p>
        <nav class="not-found-actions" aria-label="Azioni pagina 404">
          <a class="not-found-primary" href="/">Torna al Desktop</a>
          <a href={`mailto:${site.email}`}>Scrivimi</a>
        </nav>
      </div>
    </section>
  </main>

  <style>
    .not-found-shell {
      position: relative;
      width: 100vw;
      height: 100dvh;
      overflow: hidden;
      color: #1d1d1f;
      background: #050b16;
    }

    .not-found-wallpaper {
      position: absolute;
      inset: 0;
      background: #444 url("/images/sfondo-desktop.png") center/cover no-repeat;
    }

    .not-found-wallpaper::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 45%, rgba(255, 255, 255, .06), transparent 24rem),
        linear-gradient(180deg, rgba(4, 7, 15, .12), rgba(4, 7, 15, .36));
    }

    .not-found-menu {
      position: absolute;
      inset: 0 0 auto;
      z-index: 2;
      height: var(--menu-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      color: rgba(255, 255, 255, .96);
      background: rgba(255, 255, 255, .28);
      border-bottom: 1px solid rgba(255, 255, 255, .12);
      backdrop-filter: blur(28px) saturate(1.65);
      -webkit-backdrop-filter: blur(28px) saturate(1.65);
      text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
      font-size: 13px;
    }

    .not-found-menu div {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }

    .not-found-menu span,
    .not-found-menu strong,
    .not-found-menu time {
      white-space: nowrap;
    }

    .not-found-window {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 80;
      width: min(560px, calc(100vw - 32px));
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .58);
      border-radius: 14px;
      background: rgba(248, 248, 250, .92);
      box-shadow:
        0 22px 58px rgba(0, 0, 0, .16),
        0 6px 18px rgba(0, 0, 0, .10),
        inset 0 1px 0 rgba(255, 255, 255, .7);
      backdrop-filter: blur(42px) saturate(1.9);
      -webkit-backdrop-filter: blur(42px) saturate(1.9);
      transform: translate(-50%, -50%);
      animation: mainWindowPanic .44s .18s cubic-bezier(.16, 1, .3, 1) both;
    }

    .error-window-layer {
      position: absolute;
      inset: var(--menu-height) 0 0;
      z-index: 10;
      pointer-events: none;
    }

    .error-popup {
      position: absolute;
      left: clamp(160px, calc(50vw + var(--dx)), calc(100vw - 160px));
      top: clamp(116px, calc(50dvh + var(--dy)), calc(100dvh - 92px));
      z-index: var(--z);
      width: min(304px, calc(100vw - 24px));
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .62);
      border-radius: 13px;
      background: rgba(246, 246, 248, .88);
      box-shadow:
        0 12px 30px rgba(0, 0, 0, .14),
        0 3px 10px rgba(0, 0, 0, .08),
        inset 0 1px 0 rgba(255, 255, 255, .74);
      backdrop-filter: blur(28px) saturate(1.8);
      -webkit-backdrop-filter: blur(28px) saturate(1.8);
      opacity: 0;
      transform: translate3d(-50%, -50%, 0) rotate(var(--r)) scale(.88);
      transform-origin: center;
      animation:
        popupSequence .34s cubic-bezier(.18, 1.24, .28, 1) forwards,
        popupStatic .18s calc((var(--i) * .1s) + .34s) steps(2, end) 2;
      animation-delay: calc(var(--i) * .1s), calc((var(--i) * .1s) + .34s);
    }

    .error-popup-chrome {
      position: relative;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 12px;
      border-bottom: 1px solid rgba(60, 60, 67, .13);
      background: linear-gradient(180deg, rgba(255, 255, 255, .8), rgba(239, 239, 242, .58));
      user-select: none;
    }

    .error-popup-chrome .not-found-traffic {
      left: 11px;
      gap: 6px;
    }

    .error-popup-chrome .not-found-traffic span {
      width: 10px;
      height: 10px;
    }

    .error-popup-chrome strong {
      max-width: calc(100% - 104px);
      overflow: hidden;
      color: rgba(29, 29, 31, .82);
      font-size: 12.5px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .error-popup-body {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
      padding: 16px;
    }

    .error-popup-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      color: #fff;
      background: linear-gradient(180deg, #ff453a, #d70015);
      box-shadow: 0 5px 12px rgba(215, 0, 21, .16);
      font-size: 24px;
      font-weight: 700;
    }

    .error-popup-body strong {
      display: block;
      color: #1d1d1f;
      font-size: 14px;
      font-weight: 650;
      line-height: 1.2;
    }

    .error-popup-body p {
      margin: 4px 0 0;
      color: #5d5d64;
      font-size: 12.5px;
      line-height: 1.35;
    }

    .not-found-chrome {
      position: relative;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
      border-bottom: 1px solid rgba(60, 60, 67, .12);
      background: linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(242, 242, 247, .46));
      user-select: none;
    }

    .not-found-chrome strong {
      max-width: calc(100% - 160px);
      overflow: hidden;
      font-size: 13.5px;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .not-found-traffic {
      position: absolute;
      left: 16px;
      display: flex;
      gap: 8px;
    }

    .not-found-traffic span {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 .5px rgba(0, 0, 0, .2);
    }

    .not-found-traffic span:nth-child(1) { background: var(--red); }
    .not-found-traffic span:nth-child(2) { background: var(--yellow); }
    .not-found-traffic span:nth-child(3) { background: var(--green); }

    .not-found-content {
      display: grid;
      justify-items: center;
      padding: 48px 42px 42px;
      text-align: center;
      background: rgba(248, 248, 250, .54);
    }

    .not-found-icon {
      width: 92px;
      height: 92px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border-radius: 23px;
      background: linear-gradient(145deg, #fff, #d7dbe6);
      box-shadow: 0 8px 20px rgba(0, 0, 0, .10);
      color: #0a84ff;
      font-size: 48px;
      font-weight: 800;
    }

    .not-found-code {
      margin: 0 0 8px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .not-found-content h1 {
      max-width: 420px;
      margin: 0;
      color: #1d1d1f;
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.03;
      letter-spacing: 0;
    }

    .not-found-content p:not(.not-found-code) {
      max-width: 430px;
      margin: 16px 0 0;
      color: #51515a;
      font-size: 16px;
      line-height: 1.55;
    }

    .not-found-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 28px;
    }

    .not-found-actions a {
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 16px;
      border-radius: 10px;
      background: rgba(118, 118, 128, .13);
      color: #1d1d1f;
      font-weight: 700;
      text-decoration: none;
    }

    .not-found-actions a:hover {
      background: rgba(118, 118, 128, .2);
    }

    .not-found-actions .not-found-primary {
      color: #fff;
      background: var(--blue);
    }

    .not-found-actions .not-found-primary:hover {
      background: #006ee6;
    }

    @keyframes popupSequence {
      0% {
        opacity: 0;
        transform: translate3d(-50%, -46%, 0) rotate(calc(var(--r) - 7deg)) scale(.72);
      }
      72% {
        opacity: 1;
        transform: translate3d(-50%, -50%, 0) rotate(var(--r)) scale(1.035);
      }
      100% {
        opacity: 1;
        transform: translate3d(-50%, -50%, 0) rotate(var(--r)) scale(1);
      }
    }

    @keyframes popupStatic {
      0% {
        filter: saturate(1);
      }
      50% {
        filter: saturate(1.45) contrast(1.04);
      }
      100% {
        filter: saturate(1);
      }
    }

    @keyframes mainWindowPanic {
      from {
        opacity: 0;
        transform: translate(-50%, -48%) scale(.94);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }

    @media (max-width: 640px) {
      .not-found-menu span:nth-of-type(n+3) {
        display: none;
      }

      .not-found-window {
        top: 50%;
        z-index: 90;
        transform: translate(-50%, -50%);
        width: calc(100vw - 20px);
        max-height: calc(100dvh - var(--menu-height) - 28px);
        animation-name: mainWindowPanicMobile;
      }

      .error-popup {
        left: clamp(72px, calc(50vw + var(--mx)), calc(100vw - 72px));
        top: clamp(210px, calc(56dvh + var(--my)), calc(100dvh - 88px));
        width: min(260px, calc(100vw - 28px));
        border-radius: 11px;
      }

      .error-popup:nth-child(n+15) {
        display: none;
      }

      .error-popup-body {
        grid-template-columns: 34px minmax(0, 1fr);
        gap: 10px;
        padding: 12px;
      }

      .error-popup-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        font-size: 19px;
      }

      .not-found-chrome {
        height: 52px;
      }

      .not-found-content {
        padding: 38px 24px 30px;
      }

      .not-found-icon {
        width: 78px;
        height: 78px;
        border-radius: 20px;
        font-size: 40px;
      }

      .not-found-actions {
        width: 100%;
        flex-direction: column;
      }
    }

    @keyframes mainWindowPanicMobile {
      from {
        opacity: 0;
        transform: translate(-50%, calc(-50% - 10px)) scale(.96);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .not-found-window,
      .error-popup {
        opacity: 1;
        animation: none;
      }

      .error-popup:nth-child(n+7) {
        display: none;
      }
    }
  </style>
</BaseLayout>
