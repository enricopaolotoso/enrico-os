---
import { fileSystem, type FileSystemItem } from '../../data/filesystem';

const kindLabels: Record<FileSystemItem['type'], string> = {
  folder: 'Cartella',
  image: 'Immagine',
  video: 'Video',
  document: 'Documento',
  pdf: 'PDF',
  link: 'Collegamento',
  note: 'Nota',
  app: 'Applicazione',
  audio: 'Audio',
  playlist: 'Playlist'
};

const itemMark = (item: FileSystemItem) => {
  if (item.icon) return item.icon;
  if (item.type === 'folder') return '📁';
  if (item.type === 'image') return 'IMG';
  if (item.type === 'video') return '▶';
  if (item.type === 'pdf') return 'PDF';
  if (item.type === 'document') return 'DOC';
  if (item.type === 'note') return 'Nota';
  if (item.type === 'link') return '↗';
  if (item.type === 'audio') return '♪';
  if (item.type === 'playlist') return '♫';
  return 'APP';
};

const isMarkdownItem = (item: FileSystemItem) =>
  item.type === 'document' &&
  (item.mimeType === 'text/markdown' || item.name.toLowerCase().endsWith('.md'));

const finderIconClass = (item: FileSystemItem) =>
  `finder-file-icon finder-type-${item.type}${isMarkdownItem(item) ? ' finder-type-markdown' : ''}`;
---

<section
  class="mac-window finder-window"
  data-window="finder"
  data-current-path={fileSystem.path}
  style="left:72px;top:54px;width:1040px;height:650px"
  aria-label="Finder"
  role="dialog"
  aria-modal="false"
>
  <header class="mac-window-header finder-titlebar">
    <div class="mac-window-controls">
      <button type="button" data-close aria-label="Chiudi"></button>
      <button type="button" data-minimize aria-label="Riduci"></button>
      <button type="button" data-maximize aria-label="Ingrandisci"></button>
    </div>

    <div class="finder-toolbar">
      <div class="finder-nav" aria-label="Navigazione">
        <button type="button" aria-label="Indietro" data-finder-back disabled>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
        </button>
        <button type="button" aria-label="Avanti" data-finder-forward disabled>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
        </button>
      </div>

      <div class="finder-current-folder">
        <span class="finder-folder-dot"></span>
        <strong data-finder-title>{fileSystem.name}</strong>
      </div>

      <div class="finder-actions" aria-label="Azioni Finder">
        <button type="button" class="finder-view-button is-active" aria-label="Vista icone" data-finder-view="grid" aria-pressed="true">
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="4" width="4" height="4" rx="1" /><rect x="12" y="4" width="4" height="4" rx="1" /><rect x="4" y="12" width="4" height="4" rx="1" /><rect x="12" y="12" width="4" height="4" rx="1" /></svg>
        </button>
        <button type="button" class="finder-view-button" aria-label="Vista lista" data-finder-view="list" aria-pressed="false">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 6h10M5 10h10M5 14h10" /></svg>
        </button>
        <label class="finder-search">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.5" /><path d="m12 12 4 4" /></svg>
          <input type="search" placeholder="Cerca" aria-label="Cerca nella cartella" data-finder-search />
        </label>
      </div>
    </div>
  </header>

  <nav class="finder-mobile-tabs" aria-label="Sezioni Finder">
    <button type="button" data-finder-location="recent">Recenti</button>
    <button type="button" class="is-active" data-finder-location="/Desktop">Desktop</button>
    <button type="button" data-finder-location="applications">Applicazioni</button>
  </nav>

  <div class="finder-shell">
    <aside class="finder-sidebar" aria-label="Sidebar Finder">
      <div class="finder-sidebar-section">
        <p>Preferiti</p>
        <button type="button" data-finder-location="recent"><span>🕘</span>Recenti</button>
        <button type="button" class="is-active" data-finder-location="/Desktop"><span>🖥️</span>Desktop</button>
        <button type="button" data-finder-location="applications"><span>🚀</span>Applicazioni</button>
      </div>
    </aside>

    <main class="finder-main">
      <nav class="finder-pathbar" data-finder-breadcrumb aria-label="Percorso">
        <button type="button" data-finder-path="/Desktop">Desktop</button>
      </nav>

      <div class="finder-content">
        <div class="finder-panels">
          <section class="finder-grid" data-finder-grid aria-label="Contenuto della cartella">
            {(fileSystem.children ?? []).map((item) => (
              <button
                type="button"
                class="finder-file"
                data-item-id={item.id}
                data-preview-title={item.name}
                data-preview-kind={kindLabels[item.type]}
                data-preview-description={item.description ?? ''}
              >
                <span class={finderIconClass(item)} aria-hidden="true">
                  {item.thumbnail
                    ? <img src={item.thumbnail} alt="" loading="eager" />
                    : item.type === 'folder'
                      ? <img src="/apple-icons/folder.png" alt="" />
                      : itemMark(item)}
                </span>
                <span class="finder-file-name">{item.name}</span>
                <small>{kindLabels[item.type]}</small>
              </button>
            ))}
          </section>
        </div>

        <aside class="finder-preview" aria-label="Anteprima">
          <div class="finder-preview-card">
            <div class="finder-preview-icon" id="finderPreviewIcon">🖥️</div>
            <h3 id="finderPreviewTitle">{fileSystem.name}</h3>
            <p class="finder-preview-kind" id="finderPreviewKind">Cartella</p>
            <p id="finderPreviewDescription">{fileSystem.description}</p>
            <div class="finder-preview-meta">
              <div><span>Percorso</span><strong data-finder-preview-path>{fileSystem.path}</strong></div>
              <div><span>Elementi</span><strong data-finder-preview-count>{fileSystem.children?.length ?? 0}</strong></div>
            </div>
            <button type="button" class="finder-open-button" disabled>Seleziona un elemento</button>
          </div>
        </aside>
      </div>
    </main>
  </div>
</section>
