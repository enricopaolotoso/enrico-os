---
import { readdir } from 'node:fs/promises';
import { join } from 'node:path';
import { site } from '../../data/site';

const documentsDirectory = join(process.cwd(), 'public', 'documents');
let documentFiles: string[] = [];

try {
  documentFiles = (await readdir(documentsDirectory))
    .filter((file: string) => file !== '.gitkeep')
    .sort((a: string, b: string) => a.localeCompare(b, 'it', { numeric: true }));
} catch {
  documentFiles = [];
}

const documentIcon = (file: string) => {
  const extension = file.split('.').pop()?.toLowerCase();
  if (extension === 'pdf') return 'PDF';
  if (['doc', 'docx', 'odt'].includes(extension || '')) return 'DOC';
  if (['xls', 'xlsx', 'csv'].includes(extension || '')) return 'XLS';
  if (['ppt', 'pptx'].includes(extension || '')) return 'PPT';
  if (['txt', 'md', 'rtf'].includes(extension || '')) return 'TXT';
  return 'FILE';
};

const desktopItems = site.desktopItems.map((item) => ({
  id: `desktop-${item.id}`,
  name: item.title,
  kind: item.type === 'folder' ? 'Cartella desktop' : item.type === 'cover' ? 'Collegamento video' : 'Elemento desktop',
  description: `Elemento “${item.title}” presente sul desktop di Enrico Toso.`,
  action: 'app' in item ? item.app : undefined,
  href: 'href' in item ? item.href : undefined,
  image: 'image' in item ? item.image : undefined,
  icon:
    item.type === 'folder' ? '📁' :
    item.type === 'document' ? 'MD' :
    item.type === 'video' ? '▶' :
    item.type === 'pdf' ? 'PDF' :
    item.type === 'note' ? '📝' :
    item.type === 'appfile' ? 'N' : '↗'
}));

const internalApps = [
  { id: 'finder', name: 'Finder', icon: '/apple-icons/finder.png', description: 'Esplora recenti, desktop, documenti e applicazioni.' },
  { id: 'projects', name: 'Progetti', icon: '/apple-icons/folder.png', description: 'Case study e progetti costruiti sul campo.' },
  { id: 'notes', name: 'Note', icon: '/apple-icons/notes.png', description: 'Profilo, manifesto, timeline e principi.' },
  { id: 'photos', name: 'Foto', icon: '/apple-icons/photos.png', description: 'Libreria fotografica personale.' },
  { id: 'mail', name: 'Mail', icon: '/apple-icons/mail.png', description: 'Contatti e canali per collaborazioni.' },
  { id: 'terminal', name: 'Terminale', icon: '/apple-icons/terminal.png', description: 'Comandi rapidi per esplorare il portfolio.' },
  { id: 'settings', name: 'Informazioni', icon: '/apple-icons/settings.png', description: 'Biografia e profili di Enrico Toso.' },
  { id: 'spotify', name: 'Spotify', icon: '/apple-icons/spotify.svg', description: 'Playlist, top artisti e top tracce di Enrico Toso.' },
  { id: 'launchpad', name: 'Launchpad', icon: '/apple-icons/launchpad.png', description: 'Tutte le applicazioni del portfolio.' },
  { id: 'trash', name: 'Cestino', icon: '/apple-icons/trash.png', description: 'Il cestino del desktop.' }
];

const socialApps = [
  { id: 'instagram', name: 'Instagram', mark: 'IG', className: 'instagram', href: site.socials.instagram },
  { id: 'tiktok', name: 'TikTok', mark: 'TT', className: 'tiktok', href: site.socials.tiktok },
  { id: 'linkedin', name: 'LinkedIn', mark: 'in', className: 'linkedin', href: site.socials.linkedin },
  { id: 'youtube', name: 'YouTube', mark: '▶', className: 'youtube', href: site.socials.youtube },
].filter((app) => Boolean(app.href));
---

<section class="mac-window finder-window" data-window="finder" style="left:72px;top:54px;width:1040px;height:650px" aria-label="Finder" role="dialog" aria-modal="false">
  <header class="mac-window-header finder-titlebar">
    <div class="mac-window-controls">
      <button type="button" data-close aria-label="Chiudi"></button>
      <button type="button" data-minimize aria-label="Riduci"></button>
      <button type="button" data-maximize aria-label="Ingrandisci"></button>
    </div>

    <div class="finder-toolbar">
      <div class="finder-nav" aria-label="Navigazione">
        <button type="button" aria-label="Indietro" data-finder-back disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg></button>
        <button type="button" aria-label="Avanti" data-finder-forward disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg></button>
      </div>

      <div class="finder-current-folder"><span class="finder-folder-dot"></span><strong data-finder-title>Recenti</strong></div>

      <div class="finder-actions" aria-label="Azioni Finder">
        <button type="button" class="finder-view-button is-active" aria-label="Vista icone" data-finder-view="grid" aria-pressed="true"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="4" width="4" height="4" rx="1" /><rect x="12" y="4" width="4" height="4" rx="1" /><rect x="4" y="12" width="4" height="4" rx="1" /><rect x="12" y="12" width="4" height="4" rx="1" /></svg></button>
        <button type="button" class="finder-view-button" aria-label="Vista lista" data-finder-view="list" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 6h10M5 10h10M5 14h10" /></svg></button>
        <label class="finder-search"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.5" /><path d="m12 12 4 4" /></svg><input type="search" placeholder="Cerca" aria-label="Cerca nel Finder" data-finder-search /></label>
      </div>
    </div>
  </header>

  <nav class="finder-mobile-tabs" aria-label="Sezioni Finder">
    <button type="button" class="is-active" data-finder-section="recenti">Recenti</button>
    <button type="button" data-finder-section="desktop">Desktop</button>
    <button type="button" data-finder-section="documenti">Documenti</button>
    <button type="button" data-finder-section="applicazioni">Applicazioni</button>
  </nav>

  <div class="finder-shell">
    <aside class="finder-sidebar" aria-label="Sidebar Finder">
      <div class="finder-sidebar-section">
        <p>Preferiti</p>
        <button type="button" class="is-active" data-finder-section="recenti"><span>🕘</span>Recenti</button>
        <button type="button" data-finder-section="desktop"><span>🖥️</span>Desktop</button>
        <button type="button" data-finder-section="documenti"><span>📄</span>Documenti</button>
        <button type="button" data-finder-section="applicazioni"><span>🚀</span>Applicazioni</button>
      </div>
    </aside>

    <main class="finder-main">
      <div class="finder-pathbar"><span>Enrico Toso</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg><strong data-finder-path>Recenti</strong></div>

      <div class="finder-content">
        <div class="finder-panels">
          <section class="finder-grid" data-finder-panel="recenti" aria-label="Elementi recenti">
            <div class="finder-placeholder" data-recent-empty>
              <strong>Nessun elemento recente</strong>
              <p>Le app, i documenti e gli elementi aperti compariranno qui.</p>
            </div>
          </section>

          <section class="finder-grid" data-finder-panel="desktop" aria-label="Elementi desktop" hidden>
            {desktopItems.map((item) => (
              <button type="button" class="finder-file" data-finder-id={item.id} data-open={item.action} data-external-url={item.href} data-preview-title={item.name} data-preview-kind={item.kind} data-preview-description={item.description}>
                <span class="finder-file-icon" aria-hidden="true">
                  {item.image ? <img src={item.image} alt="" /> : item.icon}
                </span>
                <span class="finder-file-name">{item.name}</span><small>{item.kind}</small>
              </button>
            ))}
          </section>

          <section class="finder-grid" data-finder-panel="documenti" aria-label="Documenti" hidden>
            {documentFiles.map((file) => (
              <button type="button" class="finder-file" data-finder-id={`document-${file}`} data-external-url={`/documents/${encodeURIComponent(file)}`} data-preview-title={file} data-preview-kind="Documento" data-preview-description={`Documento disponibile nella cartella public/documents: ${file}.`}>
                <span class="finder-file-icon finder-document-icon" aria-hidden="true">{documentIcon(file)}</span>
                <span class="finder-file-name">{file}</span><small>Documento</small>
              </button>
            ))}
            {documentFiles.length === 0 && <div class="finder-placeholder"><strong>Nessun documento</strong><p>Aggiungi file nella cartella <code>public/documents</code>.</p></div>}
          </section>

          <section class="finder-grid" data-finder-panel="applicazioni" aria-label="Applicazioni" hidden>
            {internalApps.map((app) => (
              <button type="button" class="finder-file" data-finder-id={`app-${app.id}`} data-open={app.id} data-preview-title={app.name} data-preview-kind="Applicazione" data-preview-description={app.description}>
                <span class="finder-file-icon finder-app-icon" aria-hidden="true"><img src={app.icon} alt="" /></span>
                <span class="finder-file-name">{app.name}</span><small>Applicazione</small>
              </button>
            ))}
            {socialApps.map((app) => (
              <button type="button" class="finder-file" data-finder-id={`social-${app.id}`} data-external-url={app.href} data-preview-title={app.name} data-preview-kind="Social app" data-preview-description={`Apri il profilo ${app.name} di Enrico Toso.`}>
                <span class={`finder-file-icon finder-social-icon ${app.className}`} aria-hidden="true">{app.mark}</span>
                <span class="finder-file-name">{app.name}</span><small>Social app</small>
              </button>
            ))}
          </section>
        </div>

        <aside class="finder-preview" aria-label="Anteprima">
          <div class="finder-preview-card">
            <div class="finder-preview-icon" id="finderPreviewIcon">🕘</div>
            <h3 id="finderPreviewTitle">Recenti</h3>
            <p class="finder-preview-kind" id="finderPreviewKind">Cronologia locale</p>
            <p id="finderPreviewDescription">Gli ultimi elementi visualizzati in questo browser.</p>
            <div class="finder-preview-meta"><div><span>Profilo</span><strong>Enrico Toso</strong></div><div><span>Base</span><strong>Padova, Veneto</strong></div></div>
            <button type="button" class="finder-open-button" disabled>Seleziona un elemento</button>
          </div>
        </aside>
      </div>
    </main>
  </div>
</section>
