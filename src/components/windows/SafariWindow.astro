<article
  class="mac-window safari-window"
  data-window="safari"
  data-app-title="Safari"
  style="--left:17vw;--top:9vh;--w:900px;--h:610px"
  role="dialog"
  aria-label="Safari"
  aria-modal="false"
>
  <div class="window-chrome safari-chrome">
    <div class="traffic">
      <button type="button" data-close aria-label="Chiudi Safari"></button>
      <button type="button" data-minimize aria-label="Riduci Safari"></button>
      <button type="button" data-maximize aria-label="Ingrandisci Safari"></button>
    </div>
    <div class="safari-address" data-safari-address>https://</div>
  </div>

  <div class="safari-page">
    <div class="safari-card">
      <div class="safari-compass" aria-hidden="true">↗</div>
      <small>Collegamento esterno</small>
      <h2 data-safari-title>Sito web</h2>
      <p data-safari-description></p>
      <a data-safari-open href="#" target="_blank" rel="noreferrer">Apri sito</a>
    </div>
  </div>
</article>
