<article
  class="mac-window preview-window"
  data-window="preview"
  data-app-title="Anteprima"
  style="--left:22vw;--top:11vh;--w:760px;--h:610px"
  role="dialog"
  aria-label="Anteprima file"
  aria-modal="false"
>
  <div class="window-chrome">
    <div class="traffic">
      <button type="button" data-close aria-label="Chiudi Anteprima"></button>
      <button type="button" data-minimize aria-label="Riduci Anteprima"></button>
      <button type="button" data-maximize aria-label="Ingrandisci Anteprima"></button>
    </div>
    <strong data-preview-window-title>Anteprima</strong>
  </div>

  <div class="generic-preview">
    <div class="generic-preview-media" data-preview-media>
      <div class="generic-preview-placeholder">Seleziona un file</div>
    </div>
    <article class="generic-preview-copy">
      <small data-preview-type hidden>Documento</small>
      <h2 data-preview-title hidden>Anteprima</h2>
      <p data-preview-description></p>
      <a class="generic-preview-open" data-preview-open href="#" target="_blank" rel="noreferrer" hidden>
        <span aria-hidden="true">↗</span>
        Apri collegamento
      </a>
    </article>
  </div>
</article>
